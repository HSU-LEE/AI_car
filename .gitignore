# 비밀번호 (핫스팟, 파이 계정, 이미지 생성용)
credentials.txt
os-image/secrets.env

# SD 카드 이미지 (수 GB). 생성 스크립트(configure.sh, write_sd.sh)만 올림
os-image/*.img
os-image/*.img.gz
os-image/*.img.xz

# 주행 녹화, 사진 (용량이 크고 매번 바뀜)
runs/
snapshots/
pi/runs/

# 파이에만 있는 보정값 (aicar push도 덮어쓰지 않음)
pi/calib.json
pi/vision.json
pi/person.json
pi/person_photos/
pi/web_key.json
pi/drive.log
pi/drive.pid

# 자동 생성
.venv/
.aicar/
__pycache__/
*.pyc
.DS_Store

# 연습 경기장 (공식 타일과 인쇄용 PDF)
track/tiles/
track/*.pdf
track/*.png

# PCB 중간 산출물과 KiCad 자동 백업 (route_manual.sh 입력인 before-routing만 올림)
cad/hardware/aicar-hat/out/*
!cad/hardware/aicar-hat/out/before-routing.kicad_pcb
cad/hardware/aicar-hat/.history/
