# Passwords (hotspot, Pi account, image build)
credentials.txt
os-image/secrets.env

# SD card images (several GB). Only the build scripts (configure.sh, write_sd.sh) are kept
os-image/*.img
os-image/*.img.gz
os-image/*.img.xz

# Drive recordings and photos (large, change every time)
runs/
snapshots/
pi/runs/
pi/logs/
logs/

# Calibration kept only on the Pi (aicar push does not overwrite it)
pi/calib.json
pi/vision.json
pi/person.json
pi/person_photos/
pi/web_key.json
pi/drive.log
pi/drive.pid

# Generated
.venv/
.aicar/
__pycache__/
*.pyc
.DS_Store

# Practice arena (official tiles and print PDFs)
track/tiles/
track/*.pdf
track/*.png

# PCB intermediate files and KiCad auto backups (only before-routing, the route_manual.sh input, is kept)

# Previous settings kept by safe_io
pi/*.json.bak
