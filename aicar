#!/bin/bash
# Mac commands for AICAR: update code, drive, configure, and fetch recordings.
# Usage: aicar <command> [options]   (`aicar help` lists them)
set -uo pipefail

ROOT="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
[ -f "$ROOT/pi/car.py" ] || ROOT="$(cd "$(dirname "$0")" && pwd)"
CODE="$ROOT/pi"                 # Code uploaded to ~/aicar on the Pi.
RUNS="$ROOT/runs"               # Recordings copied to the Mac.
SNAPS="$ROOT/snapshots"
STATE="$ROOT/.aicar"            # Cached Pi address and the last push record.
REMOTE=aicar                    # Directory on the Pi (~/aicar).
PY="venv/bin/python"            # Every remote command runs after `cd ~/aicar`.
STREAM_PORT=8000
mkdir -p "$STATE" "$RUNS" "$SNAPS"

SSH_OPTS=(-o ConnectTimeout=4 -o ControlMaster=auto -o "ControlPath=$STATE/cm-%r@%h" -o ControlPersist=120
          -o ServerAliveInterval=2 -o ServerAliveCountMax=3)   # Notice a dropped link within 6 seconds.
# Upload code only. Leave Pi-local config (json), recordings, the venv, and models alone.
SYNC_EXCLUDES=(--exclude venv/ --exclude runs/ --exclude models/ --exclude __pycache__/ --exclude '*.json' --exclude person_photos/ --exclude '*.bak' --exclude '*.csv' --exclude logs/
               --exclude '.lgd-*' --exclude '*.jpg' --exclude '*.mp4' --exclude drive.log --exclude drive.pid)

red() { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
bold() { printf '\033[1m%s\033[0m\n' "$*"; }
die() { red "$*"; exit 1; }

# --- Find the Pi ---
is_aicar() {
    nc -z -G 1 "$1" 22 2>/dev/null &&
        [ "$(ssh "${SSH_OPTS[@]}" -o BatchMode=yes "pi@$1" hostname 2>/dev/null)" = "aicar" ]
}

find_host() {
    # AICAR_HOST, then the last address, home Wi-Fi, the hotspot, then a scan of this network.
    local h
    for h in ${AICAR_HOST:-} $(cat "$STATE/host" 2>/dev/null) 192.168.0.38 10.42.0.1; do
        if is_aicar "$h"; then echo "$h" > "$STATE/host"; echo "$h"; return 0; fi
    done
    local ip prefix
    ip=$(ipconfig getifaddr en0 2>/dev/null) || return 1
    prefix=${ip%.*}
    for h in $( (for i in $(seq 1 254); do (nc -z -G 1 "$prefix.$i" 22 2>/dev/null && echo "$prefix.$i") & done; wait) ); do
        if is_aicar "$h"; then echo "$h" > "$STATE/host"; echo "$h"; return 0; fi
    done
    return 1
}

HOST=""
host() {
    [ -n "$HOST" ] && return
    HOST=$(find_host) || die "Cannot find the Pi. Check its power and the Mac Wi-Fi (home Wi-Fi or the car hotspot)."
}
run() { host; ssh "${SSH_OPTS[@]}" "pi@$HOST" "$@"; }            # Command that only needs output.
run_tty() { host; ssh "${SSH_OPTS[@]}" -t "pi@$HOST" "$@"; }     # Command that needs a keyboard or Ctrl+C.
in_dir() { echo "cd ~/$REMOTE && $*"; }

open_stream() {
    # Wait until the view server is up (30s), then open the browser.
    # Opening early shows an error page. Once open, the page reconnects on its own.
    (for _ in $(seq 60); do
         curl -s -o /dev/null -m 1 "http://$HOST:$STREAM_PORT/" && break
         sleep 0.5
     done
     # The address with the secret can send keys from the page. Without it the page only shows the view.
     key=$(run "cat ~/$REMOTE/web_key.json" | tr -d '"')
     open "http://$HOST:$STREAM_PORT/?key=$key") >/dev/null 2>&1 &
    echo "Detection view: http://$HOST:$STREAM_PORT"
}

# --- Update code ---
remote_sums() { run "cd ~/$REMOTE && md5sum *.py 2>/dev/null"; }

cmd_push() {
    host
    local force=0; [ "${1:-}" = "-f" ] && force=1
    # Stop if the Pi was edited by hand after the last push, so those edits are not overwritten.
    if [ $force = 0 ] && [ -f "$STATE/last_push" ]; then
        local changed
        changed=$(diff <(sort "$STATE/last_push") <(remote_sums | sort) | awk '/^>/ {print $3}')
        if [ -n "$changed" ]; then
            red "Files were edited on the Pi itself: $(echo $changed)"
            echo "  To keep the Pi side:  aicar pull-code   (bring them to the Mac, then push again)"
            echo "  To overwrite with the Mac side: aicar push -f"
            exit 1
        fi
    fi
    rsync -a --delete --itemize-changes "${SYNC_EXCLUDES[@]}" -e "ssh ${SSH_OPTS[*]}" \
        "$CODE/" "pi@$HOST:$REMOTE/" | awk '$1 ~ /^\*del/ {print "  deleted: " $2; n++}
                                         $1 ~ /^<f/ {print "  updated: " $2; n++}
                                         END {if (!n) print "  no changes"}'
    [ "${PIPESTATUS[0]}" = 0 ] || { red "Pi code update failed (check the connection). Driving does not start." >&2; exit 1; }
    remote_sums > "$STATE/last_push"
    green "Pi code updated ($HOST)"
}

cmd_pull_code() {
    host
    rsync -a --itemize-changes "${SYNC_EXCLUDES[@]}" -e "ssh ${SSH_OPTS[*]}" \
        "pi@$HOST:$REMOTE/" "$CODE/" | awk '$1 ~ /^>f/ {print "  fetched: " $2; n++} END {if (!n) print "  no changes"}'
    [ "${PIPESTATUS[0]}" = 0 ] || die "Fetching the code failed (check the connection)"
    remote_sums > "$STATE/last_push"
    green "Pi code fetched into the Mac pi/ folder"
}

# --- Status ---
cmd_status() {
    host
    bold "Pi address: $HOST"
    run 'echo "Wi-Fi:"; nmcli -t -f DEVICE,CONNECTION device | grep ^wlan | sed "s/^/  /"
         ip -4 -br addr | awk "/^wlan/ {print \"  \" \$1, \$3}"
         echo "Temperature: $(vcgencmd measure_temp | cut -d= -f2)   Power: $(vcgencmd get_throttled | grep -q =0x0$ && echo OK || echo under-voltage/overheating logged)"
         echo "Disk: $(df -h / | awk "NR==2 {print \$3 \" used / \" \$2}")   recordings $(ls -d ~/aicar/runs/*/ 2>/dev/null | wc -l)"
         n=$(cat /sys/class/pwm/pwmchip0/npwm 2>/dev/null || echo 0)
         echo "Hardware PWM: $([ "$n" -ge 2 ] && echo "OK (servo GPIO18, motor GPIO13)" || echo "MISSING: servo jitters and motor speed wavers. config.txt needs dtoverlay=pwm-2chan,pin=18,func=2,pin2=13,func2=4")"
         echo "Camera: $(rpicam-hello --list-cameras 2>/dev/null | sed -n "s/^0 : \([^ ]*\).*/\1/p" | grep . || echo "NOT FOUND (check the ribbon cable)")"
         p=$(pgrep -af "python.*(lane_follow|drive_keys|tune_|car\.py)" | grep -v pgrep | sed "s#.*/python ##")
         echo "Running: ${p:-none}"'
    # Whether the Pi runs the code in the Mac pi/ folder (same file list and contents).
    local mine theirs
    mine=$(cd "$CODE" && for f in *.py *.sh; do md5 -q "$f"; done | md5 -q)
    theirs=$(run "cd ~/$REMOTE && for f in *.py *.sh; do md5sum < \$f | cut -d' ' -f1; done | md5sum | cut -d' ' -f1" 2>/dev/null)
    if [ "$mine" = "$theirs" ]; then echo "Code: same as the Mac"; else echo "Code: differs from the Mac (aicar push to update)"; fi
}

track_name() { [ "$1" = black ] && echo "black lines on a white floor" || echo "white lines on a black floor"; }

cmd_track() {
    # Save the track color in vision.json on the Pi. With no argument, show the current value and ask.
    local mode="${1:-}" cur n
    cmd_push >/dev/null || exit 1      # The Pi needs a lane_follow.py that knows this setting.
    cur=$(run "cd ~/$REMOTE && $PY -c 'import lane_follow as lf; print(lf.LINE_COLOR)'" 2>/dev/null | tail -1)
    echo "Track now: $(track_name "$cur")"
    if [ -z "$mode" ]; then
        echo "  1) white lines on a black floor"
        echo "  2) black lines on a white floor"
        read -r -p "Choose [1/2, Enter = keep]: " n
        case "$n" in 1) mode=white ;; 2) mode=black ;; *) echo "Kept as it is"; return ;; esac
    fi
    case "$mode" in white|black) ;; *) die "Usage: aicar track [white|black]" ;; esac
    if [ "$mode" = "$cur" ]; then echo "Already $(track_name "$mode")"; return; fi
    # A hand-set white threshold does not transfer to the other line color, so return it to automatic.
    run "cd ~/$REMOTE && $PY -c 'import lane_follow as lf; lf.save_vision(line_color=\"$mode\", white_thr=None)'" ||
        die "Saving failed"
    green "Track saved: $(track_name "$mode"). Used from the next drive."
    echo "  The line threshold went back to automatic. If needed, set it again with aicar tune-white."
}

cmd_config() {
    run "cd ~/$REMOTE && echo '[calib.json] servo calibration (motor_min is not read; the lowest speed is MOTOR_MIN in lane_follow.py)'; cat calib.json 2>/dev/null || echo '  (none)'; echo
         echo '[vision.json] lines/camera'; cat vision.json 2>/dev/null || echo '  (none - automatic)'; echo"
    bold "[lane_follow.py main settings] (edit pi/lane_follow.py on the Mac, then aicar push)"
    grep -E '^(BASE_SPEED|MIN_SPEED|KP|KH|KD|SMOOTH|AUTO_STEER_MAX|STEER_RATE|ROI_TOP|LINE_MODE|LENS_POSITION|JUNCTION_Y|EDGE_STOP_Y|AUTO_TRIM) ' \
        "$CODE/lane_follow.py" | sed 's/^/  /'
    bold "[car.py steering]"
    grep -E '^(STEER_LIMIT|STEER_SCALE|STEER_INVERT|SERVO_PIN|MOTOR_PWM)' "$CODE/car.py" | sed 's/^/  /'
}

# --- Recordings ---
latest_run() { run "ls -1 ~/$REMOTE/runs | tail -1"; }

cmd_runs() {
    run "cd ~/$REMOTE/runs 2>/dev/null && for d in \$(ls -1); do
           printf '  %s  %5s frames  %s\n' \$d \$(ls \$d | grep -c jpg\$) \$(du -sh \$d | cut -f1); done"
    echo "Recordings on the Mac: $(ls -1 "$RUNS" | wc -l | tr -d ' ') ($RUNS)"
}

LOGS="$ROOT/logs"               # Drive logs copied to the Mac.

cmd_logs() {
    run "cd ~/$REMOTE/logs 2>/dev/null && for d in \$(ls -1); do
           printf '  %s  %6s frames  %s\n' \$d \$(( \$(wc -l < \$d/log.csv) - 1 )) \"\$(grep -a -c 'done\]' \$d/out.log) actions ended\"; done" ||
        echo "  no drive logs yet (every drive makes one from now on)"
}

drive_log_on() { [ "$(cat "$STATE/drive_log" 2>/dev/null)" != off ]; }

cmd_drive_log() {
    # Whether every drive keeps a log (logs/ on the Pi). Remembered on this Mac. on | off | toggle, or nothing to show it.
    case "${1:-}" in
        on)     echo on > "$STATE/drive_log" ;;
        off)    echo off > "$STATE/drive_log" ;;
        toggle) if drive_log_on; then echo off > "$STATE/drive_log"; else echo on > "$STATE/drive_log"; fi ;;
        "")     ;;
        *)      die "Usage: aicar drive-log [on|off|toggle]" ;;
    esac
    if drive_log_on; then green "Drive log: ON (every drive keeps a log on the Pi, see aicar logs)"
    else echo "Drive log: OFF (drives keep no log)"; fi
}

cmd_fetch_log() {
    # Bring one drive log to the Mac and show what happened: each action's start and end, measurements, warnings, errors.
    local name="${1:-latest}"
    host
    [ "$name" = latest ] && name=$(run "ls -1 ~/$REMOTE/logs 2>/dev/null | tail -1")
    [ -n "$name" ] || die "No drive logs yet"
    mkdir -p "$LOGS"
    rsync -a -e "ssh ${SSH_OPTS[*]}" "pi@$HOST:$REMOTE/logs/$name" "$LOGS/" || die "Download failed: $name"
    green "Fetched: $LOGS/$name"
    tr '\r' '\n' < "$LOGS/$name/out.log" | grep -a -E '^\[|done\]|warning|error|Error|Traceback|Stopped|Course done|Motor' | grep -a -v '^$' | tail -n 60
}

cmd_fetch() {
    local name="${1:-latest}"
    [ "$name" = latest ] && name=$(latest_run)
    [ -n "$name" ] || die "No recordings"
    host
    echo "Fetching: $name"
    rsync -a -e "ssh ${SSH_OPTS[*]}" "pi@$HOST:$REMOTE/runs/$name" "$RUNS/" || die "Download failed: $name"
    green "Fetched: $RUNS/$name"
}

ensure_mac_venv() {
    if [ ! -x "$ROOT/.venv/bin/python" ]; then
        echo "Making the Python environment for analysis on the Mac (first time only)..."
        python3 -m venv "$ROOT/.venv" && "$ROOT/.venv/bin/pip" install -q numpy opencv-python flask || die "Installing the environment failed"
    fi
    "$ROOT/.venv/bin/python" -c "import flask, ai_edge_litert" 2>/dev/null || "$ROOT/.venv/bin/pip" install -q flask ai-edge-litert || die "Installing the environment failed"
}

cmd_replay() {
    local name="${1:-latest}"; shift || true
    if [ "$name" = latest ]; then
        # The Pi's newest, or with no Pi around, the newest copy on this Mac.
        name=$(latest_run 2>/dev/null) || name=""
        [ -n "$name" ] || name=$(ls -1d "$RUNS"/2*/ 2>/dev/null | tail -1 | xargs -n 1 basename 2>/dev/null)
        [ -n "$name" ] || die "No recordings"
    fi
    [ -d "$RUNS/$name" ] || cmd_fetch "$name"
    ensure_mac_venv
    (cd "$CODE" && "$ROOT/.venv/bin/python" replay.py "$RUNS/$name" "$@") && open "$RUNS/$name/replay.mp4"
}

cmd_clean_runs() {
    local keep="${1:-5}"
    local list
    list=$(run "ls -1 ~/$REMOTE/runs 2>/dev/null | head -n -$keep")
    [ -n "$list" ] || { echo "No recordings to delete (the last ${keep} are kept)"; return; }
    echo "Recordings to delete on the Pi ($(echo "$list" | wc -l | tr -d ' '), the last ${keep} are kept):"
    echo "$list" | sed 's/^/  /'
    read -r -p "Delete them? Copies fetched to the Mac are not deleted [y/N] " yn
    [ "$yn" = y ] || [ "$yn" = Y ] || { echo "Cancelled"; return; }
    run "cd ~/$REMOTE/runs && rm -rf $(echo $list)" && green "Deleted"
}

cmd_snap() {
    local name="snap-$(date +%Y%m%d-%H%M%S).jpg"
    run "$(in_dir "$PY snap.py /tmp/$name")" | grep -v -E 'INFO|WARN|^\[' ||
        die "Photo failed (if a drive program has the camera, aicar stop first)"
    scp -q "${SSH_OPTS[@]}" "pi@$HOST:/tmp/$name" "$SNAPS/$name" && run "rm -f /tmp/$name" && open "$SNAPS/$name"
    green "Saved: $SNAPS/$name"
}

cmd_person() {
    # Ask first, before anything connects, so the choice comes up the moment this starts.
    local mode="${1:-}" key
    if [ -z "$mode" ]; then
        echo
        bold "LEGO figure registration"
        echo "  1) new        replace the saved figure"
        echo "  2) add        add views to the saved figure"
        echo
        read -r -n 1 -p "Choose [1/2, other key = cancel]: " key; echo
        case "$key" in 1) mode=new ;; 2) mode=add ;; *) echo "Cancelled"; return ;; esac
    fi
    case "$mode" in
        new)
            mode=""
            echo "Warning: the saved figure and its photos will be deleted and replaced."
            read -r -n 1 -p "Continue? [y/n]: " key; echo
            [ "$key" = y ] || [ "$key" = Y ] || { echo "Cancelled"; return; } ;;
        add|--add) mode="--add" ;;
        *) die "Usage: aicar person [new|add]" ;;
    esac
    run "$DRIVING" && die "A drive has the camera. aicar stop first"
    cmd_push >/dev/null || exit 1
    run "bash ~/$REMOTE/stop_all.sh" >/dev/null     # Free the camera if Live View or another program has it.
    open_stream
    run_tty "$(in_dir "LIBCAMERA_LOG_LEVELS=*:ERROR $PY tune_person.py $mode")"     # Without the camera's log lines over the instructions.
}

cmd_landmark() {
    # Register the traffic light (light) or the crosswalk (crosswalk) by dragging boxes on the web page, like the figure.
    local kind="$1" mode="${2:-}" key name point=""
    case "$kind" in light) name="traffic light" ;; crosswalk) name="crosswalk" ;; line) name="lane lines" ;; stop) name="stop points" ;; esac
    if [ -z "$mode" ]; then
        echo
        bold "$name registration"
        echo "  1) new        replace the saved $name"
        echo "  2) add        add to the saved $name"
        if [ "$kind" = stop ]; then
            echo "  3) more       more views of a registered stop point (A-Z)"
        fi
        echo
        read -r -n 1 -p "Choose [1/2$([ "$kind" = stop ] && echo /3), other key = cancel]: " key; echo
        case "$key" in 1) mode=new ;; 2) mode=add ;; 3) [ "$kind" = stop ] && mode=more || { echo "Cancelled"; return; } ;; *) echo "Cancelled"; return ;; esac
    fi
    if [ "$mode" = more ]; then
        [ "$kind" = stop ] || die "Usage: aicar $kind [new|add]"
        point="${3:-}"
        if [ -z "$point" ]; then
            host
            echo "Registered: $(run "cat ~/$REMOTE/stops.json 2>/dev/null" | python3 -c 'import json,sys
try:
    p = json.load(sys.stdin)["points"]; print(", ".join(k + " (" + str(len(v["views"])) + " views)" for k, v in sorted(p.items())) or "none")
except Exception:
    print("none")')"
            read -r -n 1 -p "Which stop point [A-Z]: " point; echo
        fi
        point=$(echo "$point" | tr '[:lower:]' '[:upper:]')
        [[ "$point" =~ ^[A-Z]$ ]] || die "The stop point must be one letter A-Z"
        mode="--add --point $point"
    fi
    case "$mode" in
        new)
            mode=""
            echo "Warning: the saved $name will be replaced when you save."
            read -r -n 1 -p "Continue? [y/n]: " key; echo
            [ "$key" = y ] || [ "$key" = Y ] || { echo "Cancelled"; return; } ;;
        add|--add) mode="--add" ;;
        --add\ --point\ ?) ;;
        *) die "Usage: aicar $kind [new|add$([ "$kind" = stop ] && echo "|more [A-Z]")]" ;;
    esac
    run "$DRIVING" && die "A drive has the camera. aicar stop first"
    cmd_push >/dev/null || exit 1
    run "bash ~/$REMOTE/stop_all.sh" >/dev/null     # Free the camera if Live View or another program has it.
    open_stream
    run_tty "$(in_dir "LIBCAMERA_LOG_LEVELS=*:ERROR $PY tune_landmark.py $kind $mode")"
}

cmd_calibrate() {
    # Venue calibration: track color, focus, exposure, lane width, horizon, and camera center.
    # Saved to vision.json on the Pi.
    run "$DRIVING" && die "A drive has the camera. aicar stop first"
    cmd_push || exit 1
    run "bash ~/$REMOTE/stop_all.sh" >/dev/null     # Free the camera if Live View or another program has it.
    run_tty "$(in_dir "$PY calibrate.py $*")" || die "Calibration failed"
    local name="calib-$(date +%Y%m%d-%H%M%S).jpg"
    scp -q "${SSH_OPTS[@]}" "pi@$HOST:$REMOTE/calib_view.jpg" "$SNAPS/$name" && open "$SNAPS/$name" &&
        echo "Result view: $SNAPS/$name"
}

# --- Driving ---
cmd_stop() {
    run "bash ~/$REMOTE/stop_all.sh"
}

# Shell test, run on the Pi, for whether autonomous driving is already going. Sets $p to the pid.
DRIVING='p=$(cat ~/aicar/drive.pid 2>/dev/null) && ps -p "$p" -o args= | grep -q lane_follow'

autonomous() {
    # $1 is --drive or empty. A leading number is the speed. Anything else is passed to lane_follow.py.
    local drive="$1"; shift
    local args=()
    if [ $# -gt 0 ] && [[ "$1" =~ ^[0-9.]+$ ]]; then args+=(--speed "$1"); shift; fi
    args+=("$@")
    drive_log_on || args+=(--no-log)
    run "$DRIVING" && die "A drive is already running. View: aicar log   Stop: aicar stop"
    cmd_push || exit 1
    # Run in the background on the Pi so driving continues if the Mac disconnects. Output is ~/aicar/drive.log.
    run "cd ~/$REMOTE || exit 1
         nohup setsid $PY -u lane_follow.py $drive ${args[*]:-} > drive.log 2>&1 < /dev/null &
         echo \$! > drive.pid"
    open_stream
    cmd_log
}

cmd_log() {
    # Follow the live log. Ctrl+C stops the car. If the link drops, only the view ends and the car keeps going.
    local interrupted=0 rc
    trap 'interrupted=1' INT
    run "if $DRIVING; then tail -n +1 -f --pid=\$p ~/$REMOTE/drive.log
         else cat ~/$REMOTE/drive.log 2>/dev/null; echo; echo '(no drive running)'; fi"
    rc=$?
    trap - INT
    if [ $interrupted = 1 ]; then
        echo; echo "Stopping..."
        run "bash ~/$REMOTE/stop_all.sh; echo; tail -n 3 ~/$REMOTE/drive.log" ||
            red "Cannot reach the Pi, so the stop was not sent. As soon as it reconnects: aicar stop"
    elif [ $rc = 255 ]; then
        echo; red "Lost the connection to the Pi. The car keeps driving on the Pi."
        echo "  Once reconnected, view: aicar log   stop: aicar stop"
    fi
}

# --- Wi-Fi ---
# Shell test, run on the Pi, for whether the USB adapter (wlan1) is a Wi-Fi device.
HAS_WLAN1='nmcli -t -f DEVICE,TYPE device | grep -qx "wlan1:wifi"'
NO_WLAN1_MSG="The USB Wi-Fi adapter (wlan1) is not found. Unplug it from the Pi, plug it back in, and check with aicar wifi after 10 s.
  (a blue USB 3.0 port is best. If it still fails, aicar reboot)"

cmd_wifi() {
    run 'echo "[connection]"; nmcli -t -f DEVICE,CONNECTION device | grep ^wlan | sed "s/^/  /"
         echo "[saved Wi-Fi]"; nmcli -t -f NAME,TYPE,AUTOCONNECT connection show | awk -F: "\$2 ~ /wireless/ && \$1 != \"AICAR-AP\" {print \"  \" \$1}"'
    echo "[Wi-Fi nearby (USB adapter)]"
    if run "$HAS_WLAN1"; then
        run 'sudo nmcli device wifi rescan ifname wlan1 2>/dev/null; sleep 2
             nmcli -f SSID,SIGNAL,SECURITY device wifi list ifname wlan1 | sed "s/^/  /" | head -15'
    else
        red "  $NO_WLAN1_MSG"
    fi
}

cmd_wifi_add() {
    # Join a new network on the USB adapter (wlan1) and save it. It reconnects when that network is present.
    local ssid="${1:-}" pass="${2:-}"
    run "$HAS_WLAN1" || die "$NO_WLAN1_MSG"
    [ -n "$ssid" ] || read -r -p "Wi-Fi name (SSID): " ssid
    [ -n "$ssid" ] || die "A Wi-Fi name is needed"
    if [ $# -lt 2 ]; then read -r -s -p "Password (Enter if none): " pass; echo; fi
    local q_ssid q_pass
    q_ssid=$(printf '%q' "$ssid"); q_pass=$(printf '%q' "$pass")
    echo "Connecting the Pi to '$ssid'..."
    if [ -n "$pass" ]; then
        run "sudo nmcli device wifi rescan ifname wlan1 2>/dev/null; sleep 2; sudo nmcli device wifi connect $q_ssid password $q_pass ifname wlan1"
    else
        run "sudo nmcli device wifi rescan ifname wlan1 2>/dev/null; sleep 2; sudo nmcli device wifi connect $q_ssid ifname wlan1"
    fi || die "Connecting failed. Check the name/password, or see nearby Wi-Fi with aicar wifi."
    run "ip -4 -br addr show wlan1" | awk '{print "Pi wlan1 address: " $3}'
    green "Saved. With the Mac on '$ssid' too, aicar finds the Pi by itself."
}

cmd_wifi_del() {
    local ssid="${1:-}"
    [ -n "$ssid" ] || read -r -p "Wi-Fi name to delete: " ssid
    [ "$ssid" != "AICAR-AP" ] || die "The car hotspot cannot be deleted"
    run "sudo nmcli connection delete id $(printf '%q' "$ssid")" && green "Deleted: $ssid"
}

usage() {
    cat <<'EOF'
AICAR commands  (in a Mac terminal: aicar <command>)

[connect / update]
  status                 Pi address, Wi-Fi, temperature, disk, running programs
  push [-f]              copy the code in the Mac pi/ folder to the Pi (go/view do it by themselves)
  pull-code              bring code edited on the Pi into the Mac pi/ folder
  ssh                    open a Pi terminal
  check                  check the Pi Python environment
  test-vision            check detection and course logic on synthetic images (on the Mac, no Pi needed)
  reboot | shutdown      reboot / shut down the Pi safely (shutdown before unplugging)
  wifi                   Pi Wi-Fi status, saved networks, nearby networks
  wifi-add [name] [pw]   connect the Pi USB adapter to a new Wi-Fi and save it (asks if not given)
  wifi-del <name>        delete a saved Wi-Fi

[manual]
  drive-keys [max]       drive with the keyboard (w/s speed, a/d steer, space stop, q quit)
  center                 center the steering
  steer <angle>          steer for 1 s, then back to center (-26 to 26, negative = left)
  drive <speed> [sec]    drive straight (speed -1 to 1, negative = reverse, 1 s by default)
  test                   steering + forward/reverse test
  stop                   stop the running drive at once

[autonomous]  (opens the detection view in the browser, Ctrl+C stops. The car keeps driving if the Mac disconnects)
  view [options]         lane detection + steering only (motor off). Push the car by hand to check
  go [speed] [options]   drive (for example aicar go 0.3)
      options: --start N            start from step N of course.py
               --record             record to runs/
               --set KP=1.8 KH=1.0  change settings for this run only
  log                    show the running drive output again (after a disconnect, Ctrl+C stops)
  course                 edit the course (course.py) on the Mac, then aicar push

[settings]
  config                 show the current settings (calibration, lines, main driving values)
  calibrate [--dry]      automatic calibration on the arena (car in the middle of a straight lane): track color, focus, light,
                         lane width / vanishing point, camera center, then saved. --dry only measures
  gap-probe [sec]        lane gap check (no motor): push the car by hand toward a gap; logs where it was found per frame and why not
  focus                  only measure the sharpest focus (car on the track). Not saved; driving stays at about 15 cm
  track [white|black]    track color: white = white lines on a black floor, black = black lines on a white floor (asks if not given)
  tune-center            set the servo center with the keyboard (s saves)
  trim <deg>             move the servo center by this much and save (for example aicar trim -0.5)
  tune-white             set the line threshold (watching the browser, w/s, Enter saves)
  tune-light             set the traffic light thresholds (watching the browser, w/s e/d r/f, Enter saves)
  person [new|add]       register the LEGO figure anew / add views (asks if not given). Stand it in the box and turn it; views are taken by themselves, Enter saves. Stop position and delays are in course.py
  light [new|add]        register the traffic light: on the web page, drag a box around the lit red lamp, then the green one. Enter saves.
                         wait_green then looks only for lamps like these. With none registered, the color thresholds are used
  crosswalk [new|add]    register the crosswalk: drag a box around its stripes, from 2-3 distances. Enter saves.
                         Used by _to_crosswalk() / _pass_crosswalk() (to_crosswalk / pass_crosswalk stay as they are)
  line [new|add]         register the lane lines: drag boxes around pieces of line in a few places. The reflection cut is then
                         set to this venue's paint (the other filters stay on)
  stoppoint [new|add|more X]   register stop points: stand the car where it should stop, drag a box around the line end / line across /
                         corner ahead (n = next point, up to A-Z). more X: more views of point X. In course.py: go_to("A")
  set                    edit the driving settings file (lane_follow.py), then aicar push

[camera / recordings]
  camera                 raw camera + detection view side by side (motor and servo do not move, Ctrl+C quits)
  snap                   take a photo, bring it to the Mac and open it
  runs                   recordings on the Pi
  logs                   drive logs on the Pi: every drive keeps one (no pictures), the last 30
  fetch-log [name|latest]   bring a drive log to the Mac and show what each action did and how it ended
  drive-log [on|off|toggle] keep a log of every drive or not (on by default). With nothing: show which
  fetch [name|latest]    fetch a recording into the Mac runs/ folder
  replay [name|latest] [--set K=V]   re-analyse a recording on the Mac and open the video
  clean-runs [N]         delete Pi recordings except the last N (5 by default)

The Pi address is found automatically (home Wi-Fi 192.168.0.38 -> hotspot 10.42.0.1 -> search the same network).
To set it: AICAR_HOST=10.42.0.1 aicar status
EOF
}

# --- Dispatch ---
cmd="${1:-help}"; shift || true
case "$cmd" in
    help|-h|--help|course|set|test-vision|person|replay|light|crosswalk|line|stoppoint) ;;   # These run without a Pi connection, or ask something first and connect after.
    *) host ;;      # Look up the Pi once. Later commands reuse that address.
esac
case "$cmd" in
    status)      cmd_status ;;
    push)        cmd_push "$@" ;;
    pull-code)   cmd_pull_code ;;
    ssh)         run_tty "cd ~/$REMOTE; exec bash -l" ;;
    check)       run "$(in_dir "$PY check_env.py")" 2>&1 | grep -E '^  (OK|FAIL)|Camera' ;;
    test-vision) ensure_mac_venv; "$ROOT/.venv/bin/python" "$ROOT/tests/test_vision.py" ;;
    reboot)      run "sudo reboot" 2>/dev/null; green "Rebooting. Reconnect in about a minute." ;;
    shutdown)    run "sudo shutdown -h now" 2>/dev/null; green "Shutting the Pi down. Unplug the power once the green LED is off." ;;

    drive-keys)  cmd_push && run_tty "$(in_dir "$PY drive_keys.py ${1:+--max-speed $1}")" ;;
    center)      run "$(in_dir "$PY car.py center")" ;;
    steer)       [ $# -ge 1 ] || die "Usage: aicar steer <angle>"; run "$(in_dir "$PY car.py steer $1")" ;;
    drive)       [ $# -ge 1 ] || die "Usage: aicar drive <speed> [seconds]"; run "$(in_dir "$PY car.py drive $1 ${2:-1}")" ;;
    test)        run "$(in_dir "$PY car.py test")" ;;
    stop)        cmd_stop ;;

    view)        autonomous "" "$@" ;;
    go)          autonomous --drive "$@" ;;
    log)         cmd_log ;;
    course)      open -t "$CODE/course.py"; echo "After saving: aicar push (go updates by itself)" ;;

    config)      cmd_config ;;
    track)       cmd_track "$@" ;;
    tune-center) cmd_push && run_tty "$(in_dir "$PY tune_center.py")" ;;
    trim)        [ $# -ge 1 ] || die "Usage: aicar trim <degrees>"; run "$(in_dir "$PY car.py trim $1")" ;;
    tune-white)  cmd_push && open_stream && run_tty "$(in_dir "$PY tune_white.py")" ;;
    tune-light)  cmd_push && open_stream && run_tty "$(in_dir "$PY tune_light.py")" ;;
    person)      cmd_person "$@" ;;
    light)       cmd_landmark light "$@" ;;
    crosswalk)   cmd_landmark crosswalk "$@" ;;
    line)        cmd_landmark line "$@" ;;
    stoppoint)   cmd_landmark stop "$@" ;;
    calibrate)   cmd_calibrate "$@" ;;
    gap-probe)   run "$DRIVING" && die "A drive is running. aicar stop first"
                 cmd_push && run "bash ~/$REMOTE/stop_all.sh" >/dev/null &&
                 run "$(in_dir "$PY -u gap_probe.py ${1:-20}")" 2>&1 | grep -vE 'INFO|WARN|^\[[0-9]+:' &&
                 scp -q "${SSH_OPTS[@]}" "pi@$HOST:$REMOTE/gap_probe.csv" "$SNAPS/gap_probe.csv" &&
                 echo "Per-frame log: $SNAPS/gap_probe.csv" ;;
    focus)       run "$DRIVING" && die "A drive is running. aicar stop first"
                 cmd_push && run "bash ~/$REMOTE/stop_all.sh" >/dev/null && run "$(in_dir "$PY calibrate.py --focus-only $*")" 2>&1 | grep -vE 'INFO|WARN|^\[[0-9]+:' ;;
    camera)      run "$DRIVING" && die "A drive has the camera. View: aicar log   Stop: aicar stop"
                 cmd_push && open_stream && run_tty "$(in_dir "$PY camera_view.py")" ;;
    set)         open -t "$CODE/lane_follow.py"; echo "Edit the settings at the top, save, then: aicar push" ;;

    snap)        cmd_snap ;;
    runs)        cmd_runs ;;
    fetch)       cmd_fetch "$@" ;;
    logs)        cmd_logs ;;
    fetch-log)   cmd_fetch_log "$@" ;;
    drive-log)   cmd_drive_log "$@" ;;
    replay)      cmd_replay "$@" ;;
    clean-runs)  cmd_clean_runs "$@" ;;

    wifi)        cmd_wifi ;;
    wifi-add)    cmd_wifi_add "$@" ;;
    wifi-del)    cmd_wifi_del "$@" ;;

    help|-h|--help) usage ;;
    *)           red "Unknown command: $cmd"; echo; usage; exit 1 ;;
esac
